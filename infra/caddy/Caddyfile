# X Agent — پروکسی معکوس با HTTPS خودکار
# XAGENT_SITE_ADDRESS: دامنه (گواهی Let's Encrypt) یا https://IP (گواهی داخلی)
# XAGENT_TLS: ایمیل برای ACME یا internal
{
	admin off
	servers {
		protocols h1 h2
	}
}

{$XAGENT_SITE_ADDRESS:localhost} {
	tls {$XAGENT_TLS:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}

	# مسیر داخلی Worker→API هرگز از اینترنت در دسترس نیست
	handle /api/internal/* {
		respond 404
	}

	# API، رویدادهای زنده (SSE) و WebSocket دسکتاپ
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 60MB
	}
}

# بررسی سلامت داخلی پنل: فقط روی loopback داخل کانتینر (پورت منتشر نمی‌شود).
# به‌روزرسان، صفحه اصلی پنل و مسیر /api را از همین‌جا می‌سنجد؛ شکست آن = شکست به‌روزرسانی.
http://:8088 {
	bind 127.0.0.1
	handle /api/health {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
