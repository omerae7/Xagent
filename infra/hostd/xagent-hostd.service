[Unit]
Description=X Agent — کارگزار فرمان میزبان (Host Command Broker)
Requires=xagent-hostd.socket
After=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/xagent/xagent-hostd --config /etc/xagent/hostd.json
# کارهای در حال اجرا در Session جدا هستند و با توقف این سرویس از بین نمی‌روند
KillMode=process
NoNewPrivileges=no
PrivateTmp=yes
UMask=0022
