#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
#  xagent — مدیریت X Agent روی سرور
#  نصب در مسیر ثابت /usr/local/lib/xagent (مستقل از پوشه برنامه که هنگام به‌روزرسانی تغییر می‌کند)
#
#  xagent status | version | doctor | logs [service] | restart [service]
#  xagent update [--ref <branch|tag|commit>] [--dry-run] [--yes]
#  xagent rollback [--yes] | backup | restore <file> | password [user] | desktop on|off
# ════════════════════════════════════════════════════════════════════
set -euo pipefail
CONF="${XAGENT_CONF:-/etc/xagent.conf}"; [ -f "$CONF" ] && . "$CONF"
XAGENT_HOME="${XAGENT_HOME:-/opt/xagent}"
LIB="${XAGENT_LIB:-/usr/local/lib/xagent}"
APP="$XAGENT_HOME/app"
CTL="$XAGENT_HOME/data/control"
[ -d "$APP" ] || { echo "X Agent در $XAGENT_HOME نصب نیست."; exit 1; }
cd "$APP"
dc() { docker compose --project-directory "$APP" -f "$APP/compose.yaml" --env-file "$APP/.env" "$@"; }
need_root() { [ "$(id -u)" = "0" ] || { echo "این دستور به sudo نیاز دارد: sudo xagent $*"; exit 1; }; }
envget() { grep -E "^$1=" "$APP/.env" | tail -1 | cut -d= -f2-; }

# قفل عملیاتی مشترک: به‌روزرسانی، بازگشت، پشتیبان‌گیری و بازیابی هرگز هم‌زمان اجرا نمی‌شوند
op_lock() {
  mkdir -p "$CTL"
  exec 8>"$CTL/update.lock"
  flock -n 8 || { echo "به‌روزرسانی یا بازگشت دیگری در حال اجراست؛ پس از پایان آن دوباره تلاش کنید."; exit 3; }
}

health() {
  dc exec -T api python -c "import urllib.request;print(urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=4).read().decode())"
}

case "${1:-status}" in
  status)
    dc ps
    echo
    health || echo "API پاسخ نمی‌دهد"
    [ -f "$CTL/update.status" ] && { echo -n "آخرین به‌روزرسانی: "; cat "$CTL/update.status"; } ;;
  version)
    if [ -f "$CTL/version.json" ]; then cat "$CTL/version.json"; else
      echo "{\"version\":\"$(grep -m1 '^version' pyproject.toml | cut -d'"' -f2)\",\"commit\":\"$(git rev-parse HEAD)\"}"; fi ;;
  doctor)
    echo "پوشه نصب: $XAGENT_HOME"
    echo "فضای آزاد: $(df -h --output=avail "$XAGENT_HOME" | tail -1)"
    echo "Docker: $(docker --version 2>/dev/null || echo 'نصب نیست')"
    echo "نسخه: $(git rev-parse --short HEAD) — شاخه منبع: $(envget XAGENT_REPO_BRANCH) — ایمیج: $(envget XAGENT_IMAGE_TAG)"
    echo "تغییرات محلی: $(git status --porcelain | wc -l) فایل"
    echo "سرویس به‌روزرسان: $(systemctl is-active xagent-updater.path 2>/dev/null || echo نامشخص)"
    health || echo "API: ناسالم" ;;
  logs)    dc logs -f --tail=200 "${2:-api}" ;;
  restart) shift; dc restart "$@" ;;
  update)
    need_root update
    shift
    # اجرای نسخه موقت از به‌روزرسان تا جایگزینی خود اسکریپت در حین اجرا امن باشد
    SRC="$LIB/xagent-update"; [ -x "$SRC" ] || SRC="$APP/infra/updater/xagent-update.sh"
    TMP="$(mktemp /tmp/xagent-update.XXXXXX)"; cp "$SRC" "$TMP"; chmod 700 "$TMP"
    trap 'rm -f "$TMP"' EXIT
    XAGENT_HOME="$XAGENT_HOME" XAGENT_LIB="$LIB" bash "$TMP" "$@" ;;
  rollback)
    need_root rollback
    op_lock
    [ -f "$CTL/version.json" ] || { echo "اطلاعات نسخه قبلی موجود نیست."; exit 1; }
    vj() { python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],''))" "$CTL/version.json" "$1"; }
    CUR_COMMIT="$(vj commit)"; CUR_TAG="$(vj image_tag)"; PREV_COMMIT="$(vj previous_commit)"; PREV_TAG="$(vj previous_image_tag)"
    BACKUP="$(vj db_backup)"; PREV_REV="$(vj previous_db_revision)"; UPD_AT="$(vj updated_at)"
    [ -n "$PREV_COMMIT" ] && [ -n "$PREV_TAG" ] || { echo "نسخه قبلی ثبت نشده است (فقط پس از یک به‌روزرسانی موفق امکان‌پذیر است)."; exit 1; }
    docker image inspect "xagent/backend:$PREV_TAG" >/dev/null 2>&1 || { echo "ایمیج نسخه قبلی ($PREV_TAG) موجود نیست؛ از «xagent update --ref $PREV_COMMIT --allow-downgrade» استفاده کنید."; exit 1; }
    git cat-file -e "$PREV_COMMIT^{commit}" 2>/dev/null || git fetch -q origin
    CUR_REV="$(dc exec -T postgres psql -U xagent -d xagent -tAc 'SELECT version_num FROM alembic_version' | tr -d '[:space:]')"
    NEED_DB=0
    if [ -n "$CUR_REV" ] && ! git ls-tree -r --name-only "$PREV_COMMIT" services/api/migrations/versions | grep -q "/${CUR_REV}_"; then NEED_DB=1; fi
    echo "بازگشت از ${CUR_COMMIT:0:12} به نسخه قبلی ${PREV_COMMIT:0:12} (ایمیج $PREV_TAG)."
    if [ "$NEED_DB" = "1" ]; then
      [ -f "$BACKUP" ] || BACKUP="$(ls -1t "$XAGENT_HOME"/backups/db-*.dump 2>/dev/null | head -1)"
      echo "⚠ Schema دیتابیس ($CUR_REV) برای نسخه قبلی ناشناخته است."
      echo "   ابتدا Schema با downgrade نسخه فعلی به ${PREV_REV:-نسخه قبل} برگردانده می‌شود تا همه داده‌ها (از جمله داده‌های پس از به‌روزرسانی) حفظ شوند."
      echo "   اگر downgrade ممکن نباشد: بازیابی از پشتیبان پیش از به‌روزرسانی (${BACKUP:-ناموجود}، $UPD_AT)؛ داده‌های پس از آن در xagent_after_update_* نگه داشته می‌شوند."
    fi
    if [ "${2:-}" != "--yes" ]; then read -rp "ادامه؟ [y/N] " a; [ "$a" = "y" ] || exit 1; fi
    if [ -n "$(git status --porcelain)" ]; then git -c user.name="X Agent Updater" -c user.email=updater@xagent.local stash push --include-untracked -m "xagent-rollback-$(date +%s)" >/dev/null && echo "تغییرات محلی در git stash حفظ شدند."; fi
    S="$(date +%Y%m%d_%H%M%S)"
    if [ "$NEED_DB" = "1" ]; then
      psql_su() { dc exec -T postgres psql -v ON_ERROR_STOP=1 -U xagent -d postgres -c "$1" >/dev/null; }
      dc stop api worker
      # پشتیبان ایمنی از وضعیت فعلی پیش از هر تغییر Schema
      SAFETY="$XAGENT_HOME/backups/pre-rollback-$S.dump"
      dc exec -T postgres pg_dump -U xagent -d xagent -Fc > "$SAFETY" && chmod 600 "$SAFETY" || { echo "✗ پشتیبان ایمنی ناموفق بود؛ بازگشت متوقف شد."; dc start api worker; exit 1; }
      echo "پشتیبان ایمنی وضعیت فعلی: $SAFETY"
      if [ -n "$PREV_REV" ] && dc run --rm --no-deps -w /app/services/api --entrypoint alembic api downgrade "$PREV_REV" >/dev/null 2>&1 \
         && [ "$(dc exec -T postgres psql -U xagent -d xagent -tAc 'SELECT version_num FROM alembic_version' | tr -d '[:space:]')" = "$PREV_REV" ]; then
        echo "✓ Schema با downgrade به $PREV_REV برگشت؛ همه داده‌ها حفظ شدند."
        NEED_DB=0
      else
        [ -f "$BACKUP" ] || { echo "✗ downgrade ممکن نبود و پشتیبان پیش از به‌روزرسانی یافت نشد؛ نسخه فعلی دوباره اجرا می‌شود."; dc start api worker; exit 1; }
        echo "downgrade ممکن نبود؛ بازیابی از پشتیبان پیش از به‌روزرسانی…"
      fi
    fi
    if [ "$NEED_DB" = "1" ]; then
      psql_su "CREATE DATABASE xagent_restore_$S OWNER xagent" &&
      dc exec -T postgres pg_restore --exit-on-error -U xagent -d "xagent_restore_$S" < "$BACKUP" &&
      psql_su "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='xagent' AND pid<>pg_backend_pid()" &&
      psql_su "ALTER DATABASE xagent RENAME TO xagent_after_update_$S" &&
      psql_su "ALTER DATABASE xagent_restore_$S RENAME TO xagent" || {
        echo "✗ بازیابی دیتابیس ناموفق بود؛ نسخه فعلی دوباره اجرا می‌شود."; dc start api worker; exit 1; }
    fi
    git checkout -q --detach "$PREV_COMMIT"
    sed -i "s#^XAGENT_IMAGE_TAG=.*#XAGENT_IMAGE_TAG=$PREV_TAG#; s#^XAGENT_PREVIOUS_IMAGE_TAG=.*#XAGENT_PREVIOUS_IMAGE_TAG=$CUR_TAG#" .env
    dc up -d --remove-orphans
    for _ in $(seq 1 60); do
      if health >/dev/null 2>&1; then
        printf '{"version":"%s","commit":"%s","image_tag":"%s","previous_commit":"%s","previous_image_tag":"%s","rolled_back_at":"%s","rolled_back_db":"%s"}\n' \
          "$(grep -m1 '^version' pyproject.toml | cut -d'"' -f2)" "$PREV_COMMIT" "$PREV_TAG" "$CUR_COMMIT" "$CUR_TAG" "$(date -u +%FT%TZ)" "$NEED_DB" > "$CTL/version.json"
        printf '{"state":"rolled_back","at":"%s","message":"بازگشت دستی به %s"}\n' "$(date -u +%FT%TZ)" "${PREV_COMMIT:0:12}" > "$CTL/update.status"
        chown --reference="$CTL" "$CTL/version.json" "$CTL/update.status" 2>/dev/null || true
        echo "✓ نسخه قبلی (${PREV_COMMIT:0:12}) فعال و سالم است."; exit 0
      fi
      sleep 3
    done
    echo "✗ نسخه قبلی سالم نشد؛ xagent logs api"; exit 1 ;;
  backup)
    op_lock
    f="$XAGENT_HOME/backups/db-$(date +%Y%m%d-%H%M%S).dump"; mkdir -p "$XAGENT_HOME/backups"
    dc exec -T postgres pg_dump -U xagent -d xagent -Fc > "$f" && chmod 600 "$f" && echo "✓ $f" ;;
  restore)
    op_lock
    [ -f "${2:-}" ] || { echo "مسیر فایل پشتیبان را بدهید"; exit 1; }
    read -rp "دیتابیس فعلی با «$2» جایگزین شود؟ (نسخه فعلی با نام دیگر نگه داشته می‌شود) [y/N] " a; [ "$a" = "y" ] || exit 1
    S="$(date +%Y%m%d_%H%M%S)"
    dc exec -T postgres psql -v ON_ERROR_STOP=1 -U xagent -d postgres -c "CREATE DATABASE xagent_restore_$S OWNER xagent"
    dc exec -T postgres pg_restore --exit-on-error -U xagent -d "xagent_restore_$S" < "$2"
    dc stop api worker
    dc exec -T postgres psql -v ON_ERROR_STOP=1 -U xagent -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='xagent' AND pid<>pg_backend_pid()" >/dev/null
    dc exec -T postgres psql -v ON_ERROR_STOP=1 -U xagent -d postgres -c "ALTER DATABASE xagent RENAME TO xagent_before_restore_$S"
    dc exec -T postgres psql -v ON_ERROR_STOP=1 -U xagent -d postgres -c "ALTER DATABASE xagent_restore_$S RENAME TO xagent"
    dc start api worker && echo "✓ بازیابی شد (دیتابیس قبلی: xagent_before_restore_$S)" ;;
  password) dc exec api xagent-entrypoint cli reset-password --username "${2:-admin}" ;;
  desktop)
    need_root desktop
    case "${2:-}" in
      on)  sed -i 's/^COMPOSE_PROFILES=.*/COMPOSE_PROFILES=desktop/; s/^XAGENT_SANDBOX=.*/XAGENT_SANDBOX=desktop/' .env ;;
      off) sed -i 's/^COMPOSE_PROFILES=.*/COMPOSE_PROFILES=/; s/^XAGENT_SANDBOX=.*/XAGENT_SANDBOX=runner/' .env; dc stop desktop || true ;;
      *) echo "xagent desktop on|off"; exit 1 ;;
    esac
    dc up -d ;;
  *) sed -n '3,9p' "$0" ;;
esac
