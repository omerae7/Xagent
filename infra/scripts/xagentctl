#!/usr/bin/env bash
# مدیریت X Agent روی سرور: status | logs | restart | update | backup | restore | password | desktop on|off
set -euo pipefail
XAGENT_HOME="${XAGENT_HOME:-/opt/xagent}"
cd "$XAGENT_HOME/app"
dc() { docker compose "$@"; }
case "${1:-status}" in
  status)  dc ps; echo; curl -fsS -k "https://127.0.0.1/api/health" -H "Host: localhost" 2>/dev/null || dc exec -T api python -c "import urllib.request;print(urllib.request.urlopen('http://127.0.0.1:8000/api/health').read().decode())" ;;
  logs)    dc logs -f --tail=200 "${2:-api}" ;;
  restart) dc restart ${2:-} ;;
  update)  sudo XAGENT_HOME="$XAGENT_HOME" "$XAGENT_HOME/app/infra/updater/xagent-update.sh" ;;
  backup)  f="$XAGENT_HOME/backups/xagent-$(date +%Y%m%d-%H%M%S).dump"; mkdir -p "$XAGENT_HOME/backups"
           dc exec -T postgres pg_dump -U xagent -d xagent -Fc > "$f" && echo "✓ $f" ;;
  restore) [ -f "${2:-}" ] || { echo "مسیر فایل پشتیبان را بدهید"; exit 1; }
           read -rp "دیتابیس فعلی با «$2» جایگزین شود؟ [y/N] " a; [ "$a" = "y" ] || exit 1
           dc stop api worker && dc exec -T postgres pg_restore -U xagent -d xagent --clean --if-exists < "$2" && dc start api worker ;;
  password) dc exec api xagent-entrypoint cli reset-password --username "${2:-admin}" ;;
  desktop) case "${2:-}" in
             on)  sed -i 's/^COMPOSE_PROFILES=.*/COMPOSE_PROFILES=desktop/; s/^XAGENT_SANDBOX=.*/XAGENT_SANDBOX=desktop/' .env ;;
             off) sed -i 's/^COMPOSE_PROFILES=.*/COMPOSE_PROFILES=/; s/^XAGENT_SANDBOX=.*/XAGENT_SANDBOX=local/' .env; dc stop desktop || true ;;
             *) echo "xagent desktop on|off"; exit 1 ;;
           esac; dc up -d ;;
  *) echo "دستورها: status | logs [service] | restart [service] | update | backup | restore <file> | password [user] | desktop on|off" ;;
esac
