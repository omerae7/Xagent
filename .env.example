# نمونه پیکربندی X Agent — install.sh این فایل را به‌صورت خودکار و با اسرار تصادفی می‌سازد (.env)
XAGENT_ENV=production
XAGENT_PROFILE=standard            # lite | standard | performance
XAGENT_HOME=/opt/xagent
XAGENT_SECRET_KEY=                 # openssl rand -hex 32
POSTGRES_PASSWORD=                 # openssl rand -hex 24
DESKTOP_TOKEN=                     # openssl rand -hex 24
RUNNER_TOKEN=                      # openssl rand -hex 24
XAGENT_PUBLIC_URL=https://agent.example.com
XAGENT_SITE_ADDRESS=agent.example.com   # یا https://IP
XAGENT_TLS=you@example.com              # یا internal
XAGENT_DEFAULT_TIMEZONE=Asia/Tehran
XAGENT_COOKIE_SECURE=true
XAGENT_REPO_URL=https://github.com/omerae7/Xagent.git
XAGENT_REPO_BRANCH=main
COMPOSE_PROFILES=desktop           # خالی = بدون کانتینر دسکتاپ
XAGENT_SANDBOX=desktop             # desktop | local
XAGENT_API_WORKERS=2
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE=2GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_MEM=128MB
PG_MAX_CONNECTIONS=100
PG_MEM_LIMIT=1536m
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384m
API_MEM_LIMIT=768m
WORKER_MEM_LIMIT=1536m
DESKTOP_MEM_LIMIT=2560m
RUNNER_MEM_LIMIT=768m
DESKTOP_SHM_SIZE=512m
DESKTOP_GEOMETRY=1600x900x24
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
